# === Secrets ===
# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456:ABC-your-bot-token-here
# Brave Search API key (optional, for web search fallback)
BRAVE_API_KEY=your-brave-api-key-here

# === LLM ===
# Which LLM backend to use:
#   claude-proxy  — routes to local Claude Max proxy (localhost:3456).
#                   Requires claude-max-api-proxy + Claude Max subscription.
#   openrouter    — routes to OpenRouter API (paid per token).
#                   Requires OPENROUTER_API_KEY below.
LLM_PROVIDER=openrouter

# OpenRouter API key — get one at https://openrouter.ai/keys
# Required when LLM_PROVIDER=openrouter, ignored otherwise.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model identifier. Value depends on the provider:
#   claude-proxy : claude-opus-4-local | claude-sonnet-4-local
#   openrouter   : google/gemini-2.5-pro | google/gemini-2.5-pro
#                  anthropic/claude-sonnet-4 | meta-llama/llama-4-maverick
#                  (full list: https://openrouter.ai/models)
MODEL=google/gemini-2.5-pro

# Sampling temperature (0.0 = deterministic, 1.0 = creative). Default: 0.7
TEMPERATURE=0.7
# Max tokens per LLM response. Default: 4096
MAX_TOKENS=4096

# === Agent ===
# Max agentic loop iterations before stopping. Default: 15
MAX_ITERATIONS=30
# Number of recent messages kept in context window. Default: 40
MEMORY_WINDOW=40

# === Chrome CDP ===
# Port for Chrome DevTools Protocol (used by web-search skill). Default: 9222
# CHROME_CDP_PORT=9222

# === Telegram ===
# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone (not recommended for public deployments).
TELEGRAM_ALLOW_FROM=
# Optional SOCKS5/HTTP proxy for Telegram API (e.g. socks5://user:pass@host:port)
# TELEGRAM_PROXY=
