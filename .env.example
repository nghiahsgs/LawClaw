# === Secrets ===
TELEGRAM_TOKEN=123456:ABC-your-bot-token-here
BRAVE_API_KEY=your-brave-api-key-here

# === LLM ===
# Provider: "claude-proxy" (default) or "openrouter"
LLM_PROVIDER=claude-proxy

# --- Claude Max proxy (LLM_PROVIDER=claude-proxy) ---
# Requires: claude-max-api-proxy running at localhost:3456 + Claude Max subscription.
# Models: claude-opus-4-local, claude-sonnet-4-local
MODEL=claude-opus-4-local

# --- OpenRouter (LLM_PROVIDER=openrouter) ---
# Get your API key at https://openrouter.ai/keys
# Models: google/gemini-2.5-pro, google/gemini-2.5-flash, etc.
# Full list: https://openrouter.ai/models
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# MODEL=google/gemini-2.5-flash

TEMPERATURE=0.7
MAX_TOKENS=4096

# === Agent ===
MAX_ITERATIONS=30
MEMORY_WINDOW=40

# === Chrome CDP ===
# Port for Chrome DevTools Protocol (default 9222)
# CHROME_CDP_PORT=9222

# === Telegram ===
# Comma-separated list of allowed Telegram user IDs (empty = allow all)
TELEGRAM_ALLOW_FROM=
